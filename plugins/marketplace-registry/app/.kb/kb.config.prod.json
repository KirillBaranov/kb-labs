{
  "platform": {
    "adapters": {
      "logger": "@kb-labs/adapters-pino",
      "cache": "@kb-labs/adapters-redis",
      "storage": "@kb-labs/adapters-s3",
      "logRingBuffer": "@kb-labs/adapters-log-ringbuffer"
    },
    "adapterOptions": {
      "logger": {
        "level": "info",
        "streaming": {
          "enabled": true,
          "bufferSize": 1000,
          "bufferMaxAge": 3600000
        }
      },
      "cache": {
        "url": "redis://kb-redis:6379"
      },
      "storage": {
        "endpoint": "http://kb-minio:9000",
        "bucket": "kb-registry",
        "region": "us-east-1",
        "accessKeyId": "${MINIO_ROOT_USER}",
        "secretAccessKey": "${MINIO_ROOT_PASSWORD}",
        "forcePathStyle": true
      }
    }
  }
}

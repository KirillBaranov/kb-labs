{
  "name": "@kb-labs/clickup-contracts",
  "version": "0.1.0",
  "type": "module",
  "description": "Public types for clickup",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {

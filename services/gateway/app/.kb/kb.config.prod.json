{
  "platform": {
    "adapters": {
      "llm": "@kb-labs/adapters-openai",
      "embeddings": "@kb-labs/adapters-openai/embeddings",
      "logger": "@kb-labs/adapters-pino",
      "cache": "@kb-labs/adapters-redis",
      "documentDatabase": "@kb-labs/adapters-sqlite",
      "kvStore": "@kb-labs/adapters-sqlite/kv",
      "storage": "@kb-labs/adapters-diskio",
      "logRingBuffer": "@kb-labs/adapters-log-ringbuffer",
      "logPersistence": "@kb-labs/adapters-log-document",
      "eventBus": "@kb-labs/adapters-eventbus-cache",
      "analytics": "@kb-labs/adapters-analytics-file",
      "serviceTransport": "@kb-labs/adapters-service-transport-http"
    },
    "adapterOptions": {
      "embeddings": {
        "baseURL": "${OPENAI_PROXY_URL}"
      },
      "llm": {
        "defaultTier": "small",
        "baseURL": "${OPENAI_PROXY_URL}",
        "tierMapping": {
          "small": [
            {
              "adapter": "@kb-labs/adapters-openai",
              "model": "gpt-4o-mini",
              "priority": 1,
              "capabilities": ["fast"]
            }
          ]
        }
      },
      "logger": {
        "level": "info",
        "streaming": {
          "enabled": true,
          "bufferSize": 1000,
          "bufferMaxAge": 3600000
        }
      },
      "cache": {
        "url": "redis://kb-redis:6379"
      },
      "documentDatabase": {
        "filename": "/app/.kb/database/kb.sqlite"
      },
      "kvStore": {
        "filename": "/app/.kb/database/kb.sqlite"
      },
      "storage": {
        "basePath": "/app/.kb/storage"
      },
      "analytics": {
        "baseDir": "/app/.kb/analytics"
      },
      "serviceTransport": {
        "services": {
          "rest":        { "url": "http://kb-rest-api:5050" },
          "workflow":    { "url": "http://kb-workflow:7778" },
          "marketplace": { "url": "http://kb-marketplace:5070" },
          "registry":    { "url": "http://kb-marketplace-registry:5071" }
        }
      }
    }
  },
  "gateway": {
    "port": 4000,
    "upstreams": {
      "rest": {
        "serviceId": "rest",
        "prefix": "/api/v1",
        "websocket": true,
        "description": "REST API — main platform BFF"
      },
      "workflow": {
        "serviceId": "workflow",
        "prefix": "/api/exec",
        "rewritePrefix": "",
        "description": "Workflow Daemon"
      },
      "marketplace": {
        "serviceId": "marketplace",
        "prefix": "/api/v1/marketplace",
        "description": "Marketplace Service"
      },
      "registry": {
        "serviceId": "registry",
        "prefix": "/api/v1/registry",
        "rewritePrefix": "/api/v1",
        "description": "Marketplace Registry"
      }
    },
    "staticTokens": {},
    "configVersion": 2
  }
}

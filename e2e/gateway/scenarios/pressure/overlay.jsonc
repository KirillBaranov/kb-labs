// Gateway HTTP pressure-control overlay (ADR-0056 + core-config ADR-0001).
//
// Applied by the e2e-runner via `kb-dev ensure --scenario`. The overlay
// merges into the project `kb.config.json` and is read by gateway-app via
// the overlay-aware `readMergedRawConfig`. After the gateway restart that
// `--scenario` triggers, these limits become the effective config until
// the next scenario or `--scenario default` removes the overlay.
{
  "gateway": {
    "pressure": {
      "enabled": true,
      "perService": {
        "rest": { "requestsPerSecond": 5, "safetyMargin": 1 }
      },
      "perRoute": [
        {
          "resource": "gateway:route:health",
          "pathPrefix": "/health",
          "limits": { "requestsPerSecond": 3, "safetyMargin": 1 }
        }
      ],
      "perTenant": {
        "enabled": true,
        "limits": { "requestsPerMinute": 30, "safetyMargin": 1 }
      }
    }
  }
}

// Mind A/B overlay — disable the rerank stage.
//
// Merged into the project kb.config.json by `kb-dev ensure --scenario` and read
// by the mind plugin (configSection "mind") after the rest restart. Removed
// when the runner restores `--scenario default`.
{
  "mind": {
    "retrieval": {
      "rerank": false
    }
  }
}

// Auth E2E config overlay — applied on top of the project config inside the
// platform container. Wires SQLite as documentDatabase + kvStore so the
// gateway can initialize the user-auth stack (ADR-0020). Without this the
// gateway starts without a documentDatabase and /auth/* routes are never
// registered.
//
// Mounted by docker-compose.auth-ci.yml into the platform container at
// /workspace/kb-e2e/.kb/overlays/auth-e2e.jsonc (read-only).
// The platform config loader picks up all *.jsonc files in .kb/overlays/
// automatically — no entrypoint changes needed.
{
  "platform": {
    "adapters": {
      "documentDatabase": "@kb-labs/adapters-sqlite",
      "kvStore": "@kb-labs/adapters-sqlite/kv"
    }
  }
}

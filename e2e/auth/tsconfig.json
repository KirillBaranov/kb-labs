{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "fixtures/**/*.ts",
    "specs/**/*.ts",
    "specs-oauth/**/*.ts",
    "playwright.config.ts",
    "playwright.oauth.config.ts"
  ]
}

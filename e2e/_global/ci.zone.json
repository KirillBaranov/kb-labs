{
  "zone": "_global",
  "mode": "global",
  "watch": [
    "core/**",
    "shared/**",
    "sdk/**",
    "cli/**",
    "adapters/**",
    "tools/**",
    "pnpm-lock.yaml",
    "package.json",
    "pnpm-workspace.yaml",
    "devkit.yaml",
    "e2e/shared/**",
    "e2e/_global/**",
    "e2e/platform/**",
    "e2e/publisher/**",
    "e2e/delivery/**",
    "e2e/deploy/config-override/**",
    "e2e/scripts/**",
    "e2e/tests/**",
    "e2e/docker-compose*.yml",
    "scripts/ci/**",
    ".github/workflows/**"
  ],
  "ignore": ["docs/**", "**/*.md", ".github/ISSUE_TEMPLATE/**"]
}

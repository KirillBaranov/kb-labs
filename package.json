{
  "name": "@kb-labs/monorepo",
  "description": "KB Labs — open-source AI/infra control plane for developers.",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "author": {
    "name": "Kirill Baranov",
    "url": "https://github.com/KirillBaranov"
  },
  "license": "MIT",
  "scripts": {
    "bootstrap": "./bootstrap.sh",
    "build": "./tools/kb-devkit/kb-devkit run build",
    "build:affected": "./tools/kb-devkit/kb-devkit run build --affected",
    "build:clean": "pnpm clean && pnpm build",
    "changeset": "changeset",
    "check": "./tools/kb-devkit/kb-devkit run build lint type-check test",
    "check:affected": "./tools/kb-devkit/kb-devkit run build lint type-check test --affected",
    "clean": "pnpm -r run clean",
    "clean:all": "pnpm -r run clean && rimraf node_modules",
    "deploy": "./tools/kb-deploy/kb-deploy run",
    "deploy:all": "./tools/kb-deploy/kb-deploy run --all",
    "deploy:status": "./tools/kb-deploy/kb-deploy status",
    "deps:check": "syncpack list-mismatches",
    "deps:fix": "syncpack fix-mismatches && syncpack format",
    "deps:format": "syncpack format",
    "deps:lint": "syncpack lint",
    "deps:list": "syncpack list",
    "config:dev": "bash scripts/config-mode.sh dev",
    "config:prod": "bash scripts/config-mode.sh prod",
    "dev:logs": "./tools/kb-dev/kb-dev logs",
    "dev:restart": "./tools/kb-dev/kb-dev restart",
    "dev:start": "./tools/kb-dev/kb-dev start",
    "dev:start:dev": "./tools/kb-dev/kb-dev start infra --config .kb/devservices.dev.yaml && ./tools/kb-dev/kb-dev start backend --config .kb/devservices.dev.yaml && ./tools/kb-dev/kb-dev start ui --config .kb/devservices.dev.yaml",
    "dev:start:studio": "./tools/kb-dev/kb-dev start ui --config .kb/devservices.dev.yaml",
    "dev:start:backend": "./tools/kb-dev/kb-dev start backend --config .kb/devservices.dev.yaml",
    "dev:status": "./tools/kb-dev/kb-dev status",
    "dev:status:dev": "./tools/kb-dev/kb-dev status --config .kb/devservices.dev.yaml",
    "dev:stop": "./tools/kb-dev/kb-dev stop",
    "dev:stop:dev": "./tools/kb-dev/kb-dev stop --config .kb/devservices.dev.yaml",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "health": "./tools/kb-devkit/kb-devkit stats",
    "kb": "node ./cli/bin/dist/bin.js",
    "lint": "./tools/kb-devkit/kb-devkit run lint",
    "monitor": "./tools/kb-monitor/kb-monitor status",
    "monitor:health": "./tools/kb-monitor/kb-monitor health",
    "monitor:logs": "./tools/kb-monitor/kb-monitor logs",
    "postinstall": "[ -f scripts/fix-perms.sh ] && bash scripts/fix-perms.sh || true",
    "release": "changeset publish",
    "release:platform": "node scripts/release-preflight.mjs && ./tools/kb-devkit/kb-devkit run build && node ./cli/bin/dist/bin.js marketplace plugins refresh && node ./cli/bin/dist/bin.js release run --flow platform --skip-build --yes",
    "release:platform:dry": "./tools/kb-devkit/kb-devkit run build && node ./cli/bin/dist/bin.js marketplace plugins refresh && node ./cli/bin/dist/bin.js release run --flow platform --skip-build --dry-run",
    "release:sdk": "node scripts/release-preflight.mjs && ./tools/kb-devkit/kb-devkit run build && node ./cli/bin/dist/bin.js marketplace plugins refresh && node ./cli/bin/dist/bin.js release run --flow sdk --skip-build --yes",
    "release:sdk:dry": "./tools/kb-devkit/kb-devkit run build && node ./cli/bin/dist/bin.js marketplace plugins refresh && node ./cli/bin/dist/bin.js release run --flow sdk --skip-build --dry-run",
    "coverage": "./tools/kb-devkit/kb-devkit run test:coverage && node scripts/merge-coverage.mjs",
    "coverage:check": "node scripts/merge-coverage.mjs --check",
    "coverage:json": "./tools/kb-devkit/kb-devkit run test:coverage && node scripts/merge-coverage.mjs --json",
    "ports:generate": "node scripts/generate-ports-doc.mjs",
    "ports:check": "node scripts/checks/check-ports.mjs",
    "test": "./tools/kb-devkit/kb-devkit run test",
    "test:catalog": "node scripts/test-catalog.mjs",
    "test:catalog:check": "node scripts/test-catalog.mjs --check",
    "tools:rebuild": "bash scripts/rebuild-tool-binaries.sh",
    "type-check": "./tools/kb-devkit/kb-devkit run type-check",
    "version": "changeset version",
    "ws:check": "./tools/kb-devkit/kb-devkit check",
    "ws:fix": "./tools/kb-devkit/kb-devkit fix --safe"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.3.3",
    "js-yaml": "^4.2.0",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9.39.1",
    "knip": "^6.4.0",
    "prettier": "^3",
    "rimraf": "^6",
    "syncpack": "^14.3.0",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.11.0",
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "zod": "^3.25.76",
      "@fastify/reply-from": ">=12.6.2",
      "@fastify/static": ">=9.1.1",
      "follow-redirects": ">=1.16.0",
      "hono": ">=4.12.18",
      "koa": ">=2.16.4",
      "webpack-dev-server": ">=5.2.4",
      "ws": ">=8.20.1",
      "fast-uri": ">=3.1.2",
      "shell-quote": ">=1.8.4",
      "react-router": ">=7.14.2",
      "react-router-dom": ">=7.14.2",
      "postcss": ">=8.5.10",
      "ip-address": ">=10.1.1",
      "uuid": ">=11.1.1",
      "qs": ">=6.15.2",
      "brace-expansion@>=5.0.0 <6": ">=5.0.6",
      "esbuild": "^0.28.1"
    }
  },
  "repository": "KirillBaranov/kb-labs.git"}

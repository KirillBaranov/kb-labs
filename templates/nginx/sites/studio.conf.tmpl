# KB Labs Studio (web UI).
# Render with: envsubst < studio.conf.tmpl > studio.conf
#
# If you haven't deployed Studio yet, replace the proxy_pass with `return 503;`
# and the branded error page will be shown until you ship it.

server {
    server_name studio.${KB_DOMAIN};

    location / {
        proxy_pass http://localhost:${KB_STUDIO_PORT};
        include /etc/nginx/snippets/kb-labs/proxy-common.conf;
    }

    include /etc/nginx/snippets/kb-labs/error-pages.conf;

    listen 443 ssl;
    ssl_certificate     ${KB_CERT_PATH}/fullchain.pem;
    ssl_certificate_key ${KB_CERT_PATH}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = studio.${KB_DOMAIN}) { return 301 https://$host$request_uri; }

    listen 80;
    server_name studio.${KB_DOMAIN};
    return 404;
}

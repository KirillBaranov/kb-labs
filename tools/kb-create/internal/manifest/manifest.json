{
  "version": "3.0.0",
  "registryUrl": "https://registry.npmjs.org",
  "core": [
    {
      "name": "@kb-labs/cli-bin"
    },
    {
      "name": "@kb-labs/devkit"
    },
    {
      "name": "@kb-labs/sdk"
    },
    {
      "name": "@kb-labs/core-runtime"
    },
    {
      "name": "@kb-labs/core-contracts"
    },
    {
      "name": "@kb-labs/shared-cli-ui"
    },
    {
      "name": "@kb-labs/core-state-daemon"
    },
    {
      "name": "@kb-labs/adapters-kblabs-gateway"
    }
  ],
  "services": [
    {
      "id": "rest",
      "pkg": "@kb-labs/rest-api-app",
      "description": "REST API (port 5050)",
      "default": true,
      "port": 5050,
      "gatewayPrefix": "/api/v1",
      "gatewayWebSocket": true
    },
    {
      "id": "workflow",
      "pkg": "@kb-labs/workflow-daemon",
      "description": "Workflow engine (port 7778)",
      "default": true,
      "port": 7778,
      "gatewayPrefix": "/api/exec",
      "gatewayRewrite": "",
      "plugin": "@kb-labs/workflow-entry"
    },
    {
      "id": "gateway",
      "pkg": "@kb-labs/gateway-app",
      "description": "Central router (port 4000)",
      "default": true,
      "port": 4000
    },
    {
      "id": "marketplace",
      "pkg": "@kb-labs/marketplace-app",
      "description": "Marketplace (port 5070)",
      "default": true,
      "port": 5070,
      "gatewayPrefix": "/api/v1/marketplace"
    },
    {
      "id": "studio",
      "pkg": "@kb-labs/studio-app",
      "description": "Web UI (port 3000)",
      "default": true,
      "port": 3000
    },
    {
      "id": "mcp",
      "pkg": "@kb-labs/mcp-app",
      "description": "MCP server (port 7779)",
      "default": false,
      "port": 7779
    }
  ],
  "adapters": [
    { "name": "@kb-labs/data-store" },
    { "name": "@kb-labs/adapters-pino" },
    { "name": "@kb-labs/adapters-log-ringbuffer" },
    { "name": "@kb-labs/adapters-analytics-file" },
    { "name": "@kb-labs/adapters-service-transport-http" },
    { "name": "@kb-labs/adapters-state-broker" },
    { "name": "@kb-labs/adapters-redis" }
  ],
  "plugins": [
    {
      "id": "marketplace",
      "pkg": "@kb-labs/marketplace-entry",
      "description": "Install, list, enable plugins",
      "default": true
    },
    {
      "id": "mind",
      "pkg": "@kb-labs/mind-entry",
      "description": "AI code search (RAG)",
      "default": false
    },
    {
      "id": "agents",
      "pkg": "@kb-labs/agent-entry",
      "description": "Autonomous agents",
      "default": false
    },
    {
      "id": "ai-review",
      "pkg": "@kb-labs/review-entry",
      "description": "AI code review",
      "default": true
    },
    {
      "id": "commit",
      "pkg": "@kb-labs/commit-entry",
      "description": "AI commit generation",
      "default": true
    },
    {
      "id": "scaffold",
      "pkg": "@kb-labs/scaffold",
      "description": "Scaffold plugins and adapters",
      "default": true
    },
    {
      "id": "release",
      "pkg": "@kb-labs/release-manager-cli",
      "description": "Plan, execute, and audit releases across your workspace",
      "default": false
    }
  ],
  "adapterConfig": {
    "adapters": {
      "llm": "@kb-labs/adapters-kblabs-gateway",
      "storage": "@kb-labs/data-store",
      "logger": "@kb-labs/adapters-pino",
      "logRingBuffer": "@kb-labs/adapters-log-ringbuffer",
      "analytics": "@kb-labs/adapters-analytics-file",
      "serviceTransport": "@kb-labs/adapters-service-transport-http"
    }
  },
  "defaults": [
    {
      "id": "platform.execution.mode",
      "scope": "platform",
      "operation": "set",
      "path": "/platform/execution/mode",
      "value": "worker-pool",
      "owner": "catalog:default"
    },
    {
      "id": "adapterOptions.serviceTransport.services",
      "scope": "platform",
      "operation": "set",
      "path": "/adapterOptions/serviceTransport/services",
      "value": {},
      "owner": "catalog:default"
    },
    {
      "id": "platform.projects",
      "scope": "platform",
      "operation": "set",
      "path": "/projects",
      "value": {},
      "owner": "catalog:default"
    },
    {
      "id": "project.projects",
      "scope": "project",
      "operation": "set",
      "path": "/projects",
      "value": {},
      "owner": "catalog:default"
    },
    {
      "id": "service.rest.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/services/rest",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "service.workflow.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/services/workflow",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "service.gateway.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/services/gateway",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "service.marketplace.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/services/marketplace",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "service.studio.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/services/studio",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "service.mcp.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/services/mcp",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "plugin.marketplace.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/plugins/marketplace/enabled",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "plugin.mind.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/plugins/mind/enabled",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "plugin.agents.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/plugins/agents/enabled",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "plugin.ai-review.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/plugins/ai-review/enabled",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "plugin.commit.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/plugins/commit/enabled",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "plugin.scaffold.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/plugins/scaffold/enabled",
      "value": false,
      "owner": "catalog:default"
    },
    {
      "id": "plugin.release.disabled",
      "scope": "platform",
      "operation": "set",
      "path": "/plugins/release/enabled",
      "value": false,
      "owner": "catalog:default"
    }
  ],
  "outputs": [
    {
      "scope": "platform",
      "root": "platform",
      "path": ".kb/kb.config.jsonc",
      "format": "jsonc",
      "overwrite": "replace"
    },
    {
      "scope": "project",
      "root": "project",
      "path": ".kb/generated/kb-create.overlay.jsonc",
      "format": "jsonc",
      "overwrite": "replace"
    },
    {
      "scope": "project",
      "root": "project",
      "path": ".kb/kb.config.jsonc",
      "format": "jsonc",
      "overwrite": "createOnly"
    }
  ],
  "artifacts": [
    {
      "id": "platform.marketplace-lock",
      "root": "platform",
      "path": ".kb/marketplace.lock",
      "format": "json",
      "content": {},
      "owner": "kb-create.manifest",
      "overwrite": "replace"
    },
    {
      "id": "platform.devservices",
      "root": "platform",
      "path": ".kb/devservices.yaml",
      "format": "text",
      "text": "services:\n",
      "owner": "kb-create.manifest",
      "overwrite": "replace"
    }
  ],
  "effects": [
    {
      "id": "gateway.access.local",
      "config": [
        {
          "id": "gateway.access.local.host",
          "scope": "platform",
          "operation": "set",
          "path": "/gateway/host",
          "value": "127.0.0.1",
          "owner": "catalog:effect/gateway.access.local"
        },
        {
          "id": "gateway.access.local.auth",
          "scope": "platform",
          "operation": "set",
          "path": "/gateway/auth/enabled",
          "value": false,
          "owner": "catalog:effect/gateway.access.local"
        }
      ]
    },
    {
      "id": "gateway.access.secured",
      "config": [
        {
          "id": "gateway.access.secured.host",
          "scope": "platform",
          "operation": "set",
          "path": "/gateway/host",
          "value": "0.0.0.0",
          "owner": "catalog:effect/gateway.access.secured"
        },
        {
          "id": "gateway.access.secured.auth",
          "scope": "platform",
          "operation": "set",
          "path": "/gateway/auth/enabled",
          "value": true,
          "owner": "catalog:effect/gateway.access.secured"
        }
      ]
    }
  ],
  "migrations": [
    {
      "id": "install-state.v1-to-v2",
      "subject": "kb.install-state",
      "from": "1",
      "to": "2",
      "operations": [
        {
          "kind": "setIfMissing",
          "path": "/schema",
          "value": "kb.install-state/2"
        },
        {
          "kind": "setIfMissing",
          "path": "/mode",
          "value": "direct"
        },
        {
          "kind": "setIfMissing",
          "path": "/configSchemas",
          "value": { "platform": 1, "project": 1 }
        }
      ]
    }
  ],
  "extensions": [
    {
      "id": "studio",
      "label": "Studio",
      "description": "A local visual workspace for observing runs after you start it.",
      "bundle": { "services": ["studio"], "binaries": ["kb-dev"] }
    },
    {
      "id": "mcp",
      "label": "MCP",
      "description": "Expose KB Labs tools to an MCP-compatible coding agent on your machine.",
      "bundle": { "services": ["mcp"], "binaries": ["kb-dev"] }
    },
    {
      "id": "workflows",
      "label": "Workflows",
      "description": "Run repeatable multi-step automation with the workflow daemon.",
      "bundle": { "services": ["workflow"], "binaries": ["kb-dev"] }
    }
  ],
  "intents": [
    {
      "id": "explore",
      "label": "Just look around",
      "description": "Install the full default platform and explore.",
      "hidden": true,
      "bundle": {
        "services": ["rest", "workflow", "gateway", "marketplace", "studio"],
        "plugins": ["marketplace", "ai-review", "commit", "scaffold"],
        "binaries": ["kb-dev"]
      },
      "docs": [
        { "label": "Quick Start", "url": "https://kblabs.ru/docs/quick-start" }
      ],
      "nextSteps": ["kb-dev start", "pnpm kb --help"]
    },
    {
      "id": "commit",
      "label": "Prepare my commits",
      "description": "Create a reviewable commit plan from your current changes.",
      "bundle": {
        "plugins": ["commit"]
      },
      "firstCommand": {
        "command": "kb commit generate",
        "description": "Create a commit plan without writing git history.",
        "operation": "analyze",
        "requires": {
          "llm": "required"
        },
        "dataBoundary": "Your current git diff is sent directly to the provider whose key you choose. KB Labs Gateway is temporarily unavailable."
      },
      "steps": [
        { "type": "llmProvider" }
      ],
      "nextSteps": ["kb commit generate"]
    },
    {
      "id": "release",
      "label": "Prepare a release",
      "description": "Calculate a release plan without publishing anything.",
      "bundle": {
        "plugins": ["release"]
      },
      "firstCommand": {
        "command": "kb release plan",
        "description": "Prepare a release plan without publishing packages.",
        "operation": "analyze"
      },
      "docs": [
        { "label": "CI-install guide", "url": "https://kblabs.ru/docs/guides/ci-install" }
      ],
      "nextSteps": ["pnpm kb release plan", "pnpm kb release changelog"]
    },
    {
      "id": "plugin-author",
      "label": "Create my own command",
      "description": "Scaffold one command for a process unique to your team or agent.",
      "bundle": {
        "services": ["rest", "gateway"],
        "plugins": ["scaffold"],
        "binaries": ["kb-dev"]
      },
      "docs": [
        { "label": "First Plugin guide", "url": "https://kblabs.ru/docs/guides/first-plugin" }
      ],
      "nextSteps": ["pnpm kb scaffold plugin --name my-plugin", "kb-dev start"]
    },
    {
      "id": "ai-review",
      "label": "Add AI review to my repo",
      "description": "Automated code review, with or without your own LLM key.",
      "hidden": true,
      "bundle": {
        "plugins": ["review"]
      },
      "steps": [
        { "type": "llmProvider" }
      ],
      "docs": [
        { "label": "LLM setup guide", "url": "https://kblabs.ru/docs/guides/llm-setup" }
      ],
      "nextSteps": ["pnpm kb review run --repos . --mode heuristic"]
    },
    {
      "id": "custom",
      "label": "Advanced: choose components myself",
      "description": "Pick services, plugins, and adapters yourself.",
      "bundle": {},
      "steps": [
        { "type": "llmProvider" },
        { "type": "studioAccess" }
      ]
    }
  ],
  "binaries": [
    {
      "id": "kb-dev",
      "repo": "kb-labs-team/kb-labs",
      "name": "kb-dev",
      "description": "Service manager",
      "default": true
    },
    {
      "id": "kb-devkit",
      "repo": "kb-labs-team/kb-labs",
      "name": "kb-devkit",
      "description": "Workspace orchestrator (build, lint, test, Docker bundle)",
      "default": false
    },
    {
      "id": "kb-deploy",
      "repo": "kb-labs-team/kb-labs",
      "name": "kb-deploy",
      "description": "Deployment manager",
      "default": false
    },
    {
      "id": "kb-monitor",
      "repo": "kb-labs-team/kb-labs",
      "name": "kb-monitor",
      "description": "Runtime monitor and alerting",
      "default": false
    }
  ]
}
